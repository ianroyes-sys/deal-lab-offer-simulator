# Shared key the Next.js API routes require (cookie deal_lab_key or header x-deal-lab-key). Leave empty to deny all API calls.
DEAL_LAB_KEY=
# Folder holding fleet.json, clients.json, business.json, pipeline.json, goals.md. Defaults to ./data (CLI falls back to ./data/example).
DEAL_LAB_DATA_DIR=
# Root where saved drafts are written (drafts land in <root>/data/drafts). Defaults to the working directory.
DEAL_LAB_ROOT=
# Optional markdown file with a line like "$500 MRR" that sets the revenue target. Defaults to <data>/goals.md.
DEAL_LAB_GOALS_FILE=
# Local agent CLI used by "Sharpen" (called as: <bin> -p "<prompt>"). Defaults to claude.
DEAL_LAB_AGENT_BIN=
# Studio name printed on generated offer briefs.
DEAL_LAB_STUDIO_NAME=
NEXT_PUBLIC_STUDIO_NAME=
